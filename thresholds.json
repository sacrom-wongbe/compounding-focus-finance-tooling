{
  "CAGR": {
    "description": "Compound Annual Growth Rate (annualized return %)",
    "unit": "percentage",
    "thresholds": [0, 20, 35, 50],
    "labels": ["Negative/Flat", "Low", "Moderate", "Strong", "Exceptional"]
    
  },
  "Ratio RS vs VOO 12M ex1": {
    "description": "12-month relative strength vs VOO (ratio), excluding most recent month",
    "unit": "percentage",
    "thresholds": [0, 5, 15, 30],
    "labels": ["Neutral/Lagging", "Outperformance", "Leader", "Dominant Leader", "Late Cycling"]
  },
  "Ratio RS vs VOO 6M": {
    "description": "6-month relative strength vs VOO (ratio)",
    "unit": "percentage",
    "thresholds": [0, 7, 20, 40],
    "labels": ["Neutral/Lagging", "Outperformance", "Leader", "Dominant Leader", "Late Cycling"]
  },
  "RS Slope 6M ex1M": {
    "description": "Slope of RS over 6M, ending 1M ago",
    "unit": "percentage",
    "thresholds": [-0.1, 0, 0.2, 0.5],
    "labels": ["Regime Deterioration", "Consolidation", "Healthy Trend", "Strong Regime Expansion", "Very Strong"]
  },
  "RS Volatility 6M ex1M": {
    "description": "RS volatility (6M, annualized, end 1M ago)",
    "unit": "percentage",
    "thresholds": [10, 20, 30, 50],
    "labels": ["Dead", "Calm", "Active", "Volatile", "Casino"]
  },
  "RS Volatility 12M ex1M": {
    "description": "RS volatility (12M, annualized, end 1M ago)",
    "unit": "percentage",
    "thresholds": [10, 20, 30, 50],
    "labels": ["Dead", "Calm", "Active", "Volatile", "Casino"]
  },
  "Ratio vs SMA200": {
    "description": "Ratio series relative to 200-day SMA (percentage)",
    "unit": "percentage",
    "thresholds": [0, 5, 15, 30],
    "labels": ["Weakening Trend", "Early Trend", "Healthy Trend", "Strong", "Extended"]
  },
  "Ratio SMA200 Slope 6M": {
    "description": "Slope of 200-day SMA of ratio series over last 6 months (percent change)",
    "unit": "percentage",
    "thresholds": [-0.5, 0, 0.5, 1],
    "labels": ["Regime Deterioration", "Consolidation", "Healthy Trend", "Strong Regime Expansion", "Very Strong"]
  },
  "% Days Above SMA200 6M": {
    "description": "% of last 6 months the ratio was above its 200-day SMA",
    "unit": "percentage",
    "thresholds": [30, 50, 70, 90],
    "labels": ["Downtrending/Neutral", "Small Trend", "Persistent", "Late Cycle", "Parabolic"]
  },
  "OBV Slope 100D": {
    "description": "OBV slope over last 100 days (trend in volume flow)",
    "unit": "percentage",
    "thresholds": [-0.1, 0, 0.2, 0.5],
    "labels": ["Below Average", "Near Average", "Above Average", "Strong Accumulation", "Extreme Accumulation"]
  },
  "Persistent RVOL 60D": {
    "description": "% of last 60 days where RVOL > 1.2",
    "unit": "percentage",
    "thresholds": [10, 25, 50, 75],
    "labels": ["Rare", "Occasional", "Frequent", "Persistent", "Constant"]
  },
  "UVP 60D": {
    "description": "Up/Down Volume Pressure: (sum(Volume on up days) - sum(Volume on down days)) over 60d, normalized by total volume",
    "unit": "ratio",
    "thresholds": [-10, 0, 10, 25],
    "labels": ["Strong Down Pressure", "Down Pressure", "Neutral", "Up Pressure", "Strong Up Pressure"]
  },
  "UVP 20D": {
    "description": "Up/Down Volume Pressure: (sum(Volume on up days) - sum(Volume on down days)) over 20d, normalized by total volume",
    "unit": "ratio",
    "thresholds": [-15, 0, 15, 35],
    "labels": ["Strong Down Pressure", "Down Pressure", "Neutral", "Up Pressure", "Strong Up Pressure"]
  },
  "Max Drawdown 6M": {
    "description": "Maximum drawdown of ratio series over the last 6 months",
    "unit": "percentage",
    "thresholds": [5, 10, 20, 35],
    "labels": ["Severe", "Major", "Moderate", "Mild", "Stable"]
  },
  "Volatility 1Y": {
    "description": "Annualized volatility of ratio series",
    "unit": "percentage",
    "thresholds": [10, 20, 30, 50],
    "labels": ["Dead", "Calm", "Active", "Volatile", "Casino"]
  },
  "Volatility Ratio 20D/100D": {
    "description": "Volatility compression ratio: 20-day volume std / 100-day volume std (lower = compression)",
    "unit": "ratio",
    "thresholds": [0.5, 0.7, 1, 1.3],
    "labels": ["Highly Compressed", "Compressed", "Normal", "Elevated", "Explosive"]
  },
  "RSI 14D": {
    "description": "RSI (14) of ratio series",
    "unit": "index",
    "thresholds": [30, 45, 60, 75],
    "labels": ["Bearish", "Neutral", "Bullish", "Overbought", "Climactic"]
  },
  "RSI Slope 20D": {
    "description": "Slope of RSI (14) over last 20 days, normalized by std (trend strength in RSI)",
    "unit": "normalized slope",
    "thresholds": [-0.5, 0, 0.5, 1],
    "labels": ["Falling Fast", "Falling", "Flat/Turning Up", "Rising", "Rising Fast"]
  },
  "Momentum Efficiency Slope": {
    "description": "RSI slope (last 20d, normalized by std) divided by log-ratio slope (last 20d, normalized by std)",
    "unit": "ratio",
    "thresholds": [0, 0.4, 1, 2],
    "labels": ["Inefficient Down", "Low", "Moderate", "Efficient", "Highly Efficient"]
  },
  "Relative Pressure Balance 20D": {
    "description": "% of last 20 days RSI > 70 minus % of last 20 days RSI < 40",
    "unit": "percentage",
    "thresholds": [-30, -10, 10, 30],
    "labels": ["Very Cold", "Cold", "Neutral", "Hot", "Very Hot"]
  },
  "MACD Histogram": {
    "description": "MACD histogram (ratio, normalized)",
    "unit": "percentage",
    "thresholds": [-0.5, 0, 0.5, 1.5],
    "labels": ["Decelerating", "Flat", "Accumulating", "Accelerating", "Blowoff"]
  },
  "MACD Histogram Slope 20D": {
    "description": "Slope of MACD histogram over last 20 days (normalized as % of last value)",
    "unit": "percentage",
    "thresholds": [-0.3, 0, 0.3, 0.5],
    "labels": ["Falling Fast", "Falling", "Flat/Turning Up", "Rising", "Rising Fast"]
  },
  "Histogram Persistence 20D": {
    "description": "% of last 20 days MACD histogram > 0.05",
    "unit": "percentage",
    "thresholds": [20, 40, 60, 80],
    "labels": ["Low", "Moderate", "High", "Very High", "Extreme"]
  },
  "Price/Ratio Z-score 50D": {
    "description": "Z-score of price/ratio vs 50-day moving average (standard deviations)",
    "unit": "z-score",
    "thresholds": [-2, -1, 1, 2],
    "labels": ["Very Oversold", "Oversold", "Normal", "Overbought", "Very Overbought"]
  },
  "Distribution Days 30D": {
    "description": "Number of distribution days (high volume, price decline) in last 30 days after uptrend",
    "unit": "count",
    "thresholds": [1, 3, 5, 7],
    "labels": ["None/Rare", "Low", "Moderate", "High", "Extreme (Distribution)"]
  }
}